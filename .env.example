# 도메인 (절대 URL, 프로토콜 포함)
NEXT_PUBLIC_SITE_URL=https://gyeol.page

# Google Analytics 4 Measurement ID (없으면 빈 값으로 — GA4 자동 비활성)
NEXT_PUBLIC_GA_ID=

# Resend API 키 (Contact 폼 메일 발송용)
RESEND_API_KEY=

# Instagram Webhook verification 토큰
# Meta 개발자 콘솔 → 앱 → Instagram → Webhooks 의 "인증 토큰" 값과 동일해야 함.
# 콜백 URL: https://gyeol.page/api/webhooks/instagram
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
